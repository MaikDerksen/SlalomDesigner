# Kopiere diese Datei neben docker-compose.yml als ".env" und trage Werte ein.
# NICHTS hiervon committen – die .env bleibt auf dem NAS.

# Pflicht: zufälliges Secret mit >=32 Zeichen, z. B.:  openssl rand -hex 32
JWT_SECRET=

# Pflicht: starkes Datenbank-Passwort (frei wählbar)
POSTGRES_PASSWORD=

# Optional: nur beim allerersten Start (leere Datenbank) ausgewertet.
# Ohne SEED_PASSWORD wird ein zufälliges Passwort erzeugt und einmalig
# in den App-Logs ausgegeben.
#SEED_EMAIL=admin@meinverein.de
#SEED_PASSWORD=
#SEED_CLUB=Mein Verein e.V.
